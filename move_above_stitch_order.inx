<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

	<name>Move 1st Selected Above 2nd + Stitch Order</name>
	<id>layers_cmd_deck.move_above_stitch_order</id>

	<param name="stitch_order" type="bool" gui-hidden="true">true</param>

	<effect>
		<object-type>all</object-type>
		<effects-menu>
			<submenu name="Map's Edge Tools" translatable="no">
				<submenu name="General" translatable="no">
					<submenu name="Layers" translatable="no" />
				</submenu>
			</submenu>
		</effects-menu>
	</effect>

	<script>
		<command location="inx" interpreter="python">move_above.py</command>
	</script>

</inkscape-extension>
